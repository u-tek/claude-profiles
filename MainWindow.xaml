<Window x:Class="ClaudeProfiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeProfiles"
        Title="Claude Profiles" Width="1000" Height="700" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}"
        FontFamily="{StaticResource Sans}" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Colour swatch in the profile dialog -->
    <Style x:Key="Swatch" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Width="32" Height="32" Background="Transparent">
              <Ellipse x:Name="ring" Stroke="Transparent" StrokeThickness="2" />
              <Ellipse Width="22" Height="22" Fill="{TemplateBinding Background}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource LineStrong}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Ink}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Claude / Codex picker in the profile dialog -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="9" Padding="18,8" BorderThickness="1"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}">
              <ContentPresenter x:Name="cp" TextElement.FontSize="13.5" TextElement.FontWeight="SemiBold"
                                TextElement.Foreground="{DynamicResource Ink}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="cp" Property="TextElement.Foreground" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Serif}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Margin" Value="0,30,0,0" />
    </Style>

    <!-- Profile card -->
    <DataTemplate x:Key="CardTemplate" DataType="{x:Type local:ProfileItem}">
      <Border x:Name="card" Width="292" MinHeight="186" Margin="8" Padding="18,16" CornerRadius="14"
              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                            Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}" />
        </Border.Effect>
        <DockPanel LastChildFill="False">
          <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44">
              <Ellipse Fill="{Binding AvatarBrush}" />
              <TextBlock x:Name="initial" Text="{Binding Initial}" FontFamily="{StaticResource Serif}" FontSize="21"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
              <TextBlock x:Name="home" Text="&#xE80F;" FontFamily="{StaticResource Glyphs}" FontSize="18" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              <Border Width="14" Height="14" CornerRadius="7" Background="{DynamicResource Good}" BorderThickness="2.5"
                      BorderBrush="{DynamicResource Surface}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,-2,-2" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="13,0,6,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Caption}" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE712;" VerticalAlignment="Top"
                    Margin="0,-4,-8,0" ToolTip="More" Click="More_Click" />
          </Grid>

          <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">
            <Border x:Name="pill" HorizontalAlignment="Left" CornerRadius="10" Padding="9,3,10,4" Background="{DynamicResource SurfaceAlt}">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource Faint}" VerticalAlignment="Center" Margin="0,1,0,0" />
                <TextBlock x:Name="status" Text="{Binding StatusText}" FontSize="12" Margin="7,0,0,0" Foreground="{DynamicResource Muted}" />
              </StackPanel>
            </Border>
            <Border Margin="0,10,0,0" CornerRadius="8" Padding="10,7" Background="{DynamicResource WarnSoft}"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
              <DockPanel>
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Glyphs}" Foreground="{DynamicResource Warn}"
                           FontSize="12" Margin="0,2,8,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding WarningText}" Foreground="{DynamicResource Warn}" FontSize="12" TextWrapping="Wrap" />
              </DockPanel>
            </Border>
          </StackPanel>

          <Button x:Name="primary" DockPanel.Dock="Bottom" Margin="0,16,0,0" Content="{Binding PrimaryLabel}"
                  Style="{StaticResource AccentButton}" Click="Primary_Click" />
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMain}" Value="True">
          <Setter TargetName="initial" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="home" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRunning}" Value="True">
          <Setter TargetName="primary" Property="Style" Value="{StaticResource GhostButton}" />
          <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Good}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsWaiting}" Value="True">
          <Setter TargetName="pill" Property="Background" Value="{DynamicResource AccentSoft}" />
          <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Accent}" />
          <Setter TargetName="status" Property="Foreground" Value="{DynamicResource Accent}" />
        </DataTrigger>
        <Trigger SourceName="card" Property="IsMouseOver" Value="True">
          <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource LineStrong}" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- "New profile" tile -->
    <DataTemplate x:Key="AddTemplate">
      <Button Width="292" MinHeight="186" Margin="8" Cursor="Hand" Click="NewProfile_Click" FocusVisualStyle="{x:Null}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Rectangle x:Name="edge" RadiusX="14" RadiusY="14" Stroke="{DynamicResource LineStrong}"
                         StrokeDashArray="4 3" StrokeThickness="1.3" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="plus" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource SurfaceAlt}" HorizontalAlignment="Center">
                  <TextBlock x:Name="plusGlyph" Text="&#xE710;" FontFamily="{StaticResource Glyphs}" FontSize="15"
                             Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="New profile" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Ink}" />
                <TextBlock Text="{Binding AddCaption}" FontSize="12.5" Margin="0,3,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Muted}" />
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="edge" Property="Stroke" Value="{DynamicResource Accent}" />
                <Setter TargetName="plus" Property="Background" Value="{DynamicResource AccentSoft}" />
                <Setter TargetName="plusGlyph" Property="Foreground" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>

    <local:CardTemplateSelector x:Key="CardSelector" Card="{StaticResource CardTemplate}" Add="{StaticResource AddTemplate}" />

    <Style x:Key="DialogCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="28,26" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.22" Color="Black" />
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Frame" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Grid Grid.Row="0">
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <Image x:Name="TitleMark" Width="20" Height="20" />
          <TextBlock Text="Claude Profiles" Margin="10,0,0,1" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
          <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
          <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close to tray"
                  local:Ui.HoverBackground="#C42B1C" />
        </StackPanel>
      </Grid>

      <!-- Sign-in banner -->
      <Border x:Name="Banner" Grid.Row="1" Margin="40,6,40,0" CornerRadius="12" Padding="16,13"
              Background="{DynamicResource AccentSoft}" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Accent}" VerticalAlignment="Top">
            <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource Glyphs}" FontSize="14" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
            <TextBlock x:Name="BannerTitle" FontWeight="SemiBold" FontSize="14" />
            <TextBlock x:Name="BannerBody" Foreground="{DynamicResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="18" />
          </StackPanel>
          <Button x:Name="BannerButton" Grid.Column="2" Style="{StaticResource GhostButton}" Padding="14,7"
                  VerticalAlignment="Center" Click="BannerButton_Click" />
        </Grid>
      </Border>

      <!-- Content -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="40,22,40,24">
          <Grid>
            <StackPanel Margin="0,0,180,0">
              <TextBlock Text="Profiles" FontFamily="{StaticResource Serif}" FontSize="32" />
              <TextBlock x:Name="IntroText" Foreground="{DynamicResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21" MaxWidth="600"
                         HorizontalAlignment="Left" />
            </StackPanel>
            <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0"
                    Padding="16,9" Click="NewProfile_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Glyphs}" FontSize="12" Margin="0,1,9,0" VerticalAlignment="Center" />
                <TextBlock Text="New profile" />
              </StackPanel>
            </Button>
          </Grid>

          <Border x:Name="NotInstalled" Margin="0,26,0,0" CornerRadius="14" Padding="22,20" Background="{DynamicResource WarnSoft}" Visibility="Collapsed">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Get Claude" Click="GetClaude_Click" VerticalAlignment="Center" />
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Claude isn't installed" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="Install the Claude desktop app first, then come back here to set up your profiles." Foreground="{DynamicResource Muted}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>

          <TextBlock x:Name="ClaudeHeading" Text="Claude" Style="{StaticResource SectionHeading}" Visibility="Collapsed" />
          <ItemsControl x:Name="ClaudeCards" Margin="-8,22,-8,0" ItemTemplateSelector="{StaticResource CardSelector}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <StackPanel x:Name="CodexSection" Visibility="Collapsed">
            <TextBlock Text="Codex" Style="{StaticResource SectionHeading}" />
            <ItemsControl x:Name="CodexCards" Margin="-8,10,-8,0" ItemTemplateSelector="{StaticResource CardSelector}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Footer -->
      <DockPanel Grid.Row="3" Margin="40,0,34,12">
        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Open profiles folder" Click="OpenRoot_Click" />
        <TextBlock x:Name="FooterText" Foreground="{DynamicResource Faint}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>

      <!-- Dialogs -->
      <Grid x:Name="Overlay" Grid.RowSpan="4" Background="{DynamicResource Scrim}" Visibility="Collapsed" MouseLeftButtonDown="Overlay_MouseDown">
        <Border x:Name="EditDialog" Style="{StaticResource DialogCard}" Width="450" MouseLeftButtonDown="Dialog_MouseDown">
          <StackPanel>
            <TextBlock x:Name="EditTitle" Text="New profile" FontFamily="{StaticResource Serif}" FontSize="24" />
            <TextBlock x:Name="EditSubtitle" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="20" FontSize="13.5"
                       Text="A fresh Claude with its own sign-in, chats, folders and settings." />
            <StackPanel x:Name="AppPicker">
              <TextBlock Text="App" FontWeight="SemiBold" FontSize="12.5" Margin="0,22,0,7" />
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AppClaude" Style="{StaticResource Segment}" Content="Claude" GroupName="app" Checked="AppPick_Checked" />
                <RadioButton x:Name="AppCodex" Style="{StaticResource Segment}" Content="Codex" GroupName="app" Checked="AppPick_Checked" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="Name" FontWeight="SemiBold" FontSize="12.5" Margin="0,22,0,7" />
            <TextBox x:Name="NameBox" local:Ui.Placeholder="Work, Personal, Client…" MaxLength="40" TextChanged="NameBox_TextChanged" />
            <TextBlock x:Name="NameError" Foreground="{DynamicResource Danger}" FontSize="12" Margin="2,6,0,0" Visibility="Collapsed" />
            <TextBlock Text="Colour" FontWeight="SemiBold" FontSize="12.5" Margin="0,18,0,6" />
            <WrapPanel x:Name="Swatches" Margin="-4,0,0,0" />
            <CheckBox x:Name="ShortcutBox" Content="Add a desktop shortcut" IsChecked="True" Margin="0,20,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
              <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="CloseOverlay_Click" IsCancel="True" />
              <Button x:Name="EditOk" Style="{StaticResource AccentButton}" Content="Create and open" Margin="10,0,0,0"
                      Click="EditOk_Click" IsDefault="True" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border x:Name="ConfirmDialog" Style="{StaticResource DialogCard}" Width="430" MouseLeftButtonDown="Dialog_MouseDown">
          <StackPanel>
            <TextBlock x:Name="ConfirmTitle" FontFamily="{StaticResource Serif}" FontSize="22" TextWrapping="Wrap" />
            <TextBlock x:Name="ConfirmBody" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0" LineHeight="20" FontSize="13.5" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
              <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="CloseOverlay_Click" IsCancel="True" />
              <Button x:Name="ConfirmOk" Style="{StaticResource DangerButton}" Margin="10,0,0,0" Click="ConfirmOk_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Toast -->
      <Border x:Name="Toast" Grid.RowSpan="4" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,46"
              CornerRadius="11" Padding="16,11" Background="{DynamicResource Ink}" Opacity="0" IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Glyphs}" Foreground="{DynamicResource Bg}" FontSize="13" Margin="0,1,10,0" VerticalAlignment="Center" />
          <TextBlock x:Name="ToastText" Foreground="{DynamicResource Bg}" FontSize="13.5" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
